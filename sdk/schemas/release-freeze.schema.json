{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superexplorer.invalid/schemas/release-freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_frozen", "evidence_mode", "protected_tag", "source", "rc_id", "bundle_id", "release_input_digest", "artifacts", "protection", "signature", "provenance", "prior_release_ledger"],
  "properties": {
    "schema_version": { "const": 2 },
    "release_frozen": { "const": true },
    "evidence_mode": { "enum": ["production", "fixture"] },
    "protected_tag": { "$ref": "#/$defs/protected_tag" },
    "source": { "$ref": "#/$defs/source" },
    "rc_id": { "type": "string", "minLength": 1 },
    "bundle_id": { "type": "string", "minLength": 1 },
    "release_input_digest": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk_lock", "bundle_manifest", "ui_abi_fingerprint"],
      "properties": {
        "sdk_lock": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "sdk/sdk-lock.json" } } }] },
        "bundle_manifest": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "sdk/bundle-manifest.json" } } }] },
        "ui_abi_fingerprint": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "sdk/ui-abi-fingerprint.json" } } }] }
      }
    },
    "protection": { "$ref": "#/$defs/protection" },
    "signature": { "$ref": "#/$defs/signature" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "prior_release_ledger": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "sdk/snapshot/release-ledger.json" } } }] }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_mode": { "const": "production" } } },
      "then": { "properties": { "signature": { "properties": { "verification": { "const": "detached_gpg" } } } } }
    },
    {
      "if": { "properties": { "evidence_mode": { "const": "fixture" } } },
      "then": { "properties": { "signature": { "properties": { "verification": { "const": "fixture_unsigned" } } } } }
    }
  ],
  "$defs": {
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safe_path": { "type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?![A-Za-z]:)(?![\\\\/]).+" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/safe_path" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["revision", "tree"],
      "properties": { "revision": { "$ref": "#/$defs/git_oid" }, "tree": { "$ref": "#/$defs/git_oid" } }
    },
    "protected_tag": {
      "type": "object", "additionalProperties": false, "required": ["name", "tag_object", "object_revision", "tree"],
      "properties": {
        "name": { "type": "string", "pattern": "^gpui-sdk-v" },
        "tag_object": { "$ref": "#/$defs/git_oid" },
        "object_revision": { "$ref": "#/$defs/git_oid" },
        "tree": { "$ref": "#/$defs/git_oid" }
      }
    },
    "protection": {
      "type": "object", "additionalProperties": false, "required": ["provider", "policy_id", "record"],
      "properties": { "provider": { "type": "string", "minLength": 1 }, "policy_id": { "type": "string", "minLength": 1 }, "record": { "$ref": "#/$defs/artifact" } }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["verification", "signer", "artifact"],
      "properties": { "verification": { "enum": ["detached_gpg", "fixture_unsigned"] }, "signer": { "type": "string", "minLength": 1 }, "artifact": { "$ref": "#/$defs/artifact" } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["builder", "predicate_type", "artifact"],
      "properties": { "builder": { "type": "string", "minLength": 1 }, "predicate_type": { "type": "string", "minLength": 1 }, "artifact": { "$ref": "#/$defs/artifact" } }
    }
  }
}
