{
  "schema_version": 1,
  "package": { "id": "p0-consumer", "version": "0.1.0" },
  "publisher": {
    "id": "example-publisher",
    "display_name": "Example Publisher",
    "contacts": [{ "kind": "support", "value": "mailto:support@example.invalid" }]
  },
  "sdk": {
    "bundle_id": "@SDK_BUNDLE_ID@",
    "target": "x86_64-pc-windows-msvc",
    "abi_schema": @ABI_SCHEMA@,
    "gpui": false,
    "ui_abi_fingerprint": null
  },
  "rust": {
    "crate_name": "p0-consumer",
    "entrypoint": "plugin.dll",
    "root_module": "plugin_root"
  },
  "features": [{ "id": "main", "capabilities": ["abi"] }],
  "contributions": [
    {
      "id": "abi-root",
      "feature_id": "main",
      "kind": "abi-root",
      "capabilities": ["abi"],
      "payload": "src/lib.rs"
    }
  ],
  "payloads": [
    {
      "path": "src/lib.rs",
      "size": @SOURCE_SIZE@,
      "sha256": "@SOURCE_SHA256@",
      "kind": "rust-source"
    }
  ],
  "verification": {
    "requirements": [
      {
        "requirement_id": "build-extensible-plugin-platform/rust-plugin-abi-and-ui-toolchain/offline-sdk-bundle-and-protected-dependency-closure",
        "evidence": {
          "unit": ["plugin-root-unit"],
          "integration": ["plugin-load-compatible"],
          "uitest": ["plugin-tooling-wrapper-contract"],
          "security": ["ui-fingerprint-mismatch-rejected"],
          "docs": ["clean-readme-reproduction"]
        }
      },
      {
        "requirement_id": "build-extensible-plugin-platform/extension-package-and-feature-lifecycle/unified-package-manifest",
        "evidence": {"unit": ["package-manifest-contract"], "integration": ["package-validation-contract"], "uitest": ["package-manifest-contract"], "security": ["package-validation-contract"], "docs": ["package-lifecycle-docs-contract"]}
      },
      {
        "requirement_id": "build-extensible-plugin-platform/extension-package-and-feature-lifecycle/structured-publisher-contacts",
        "evidence": {"unit": ["package-manifest-contract"], "integration": ["package-validation-contract"], "uitest": ["package-manifest-contract"], "security": ["package-validation-contract"], "docs": ["package-lifecycle-docs-contract"]}
      },
      {
        "requirement_id": "build-extensible-plugin-platform/extension-package-and-feature-lifecycle/atomic-package-resolution",
        "evidence": {"unit": ["package-resolution-contract"], "integration": ["package-resolution-contract"], "uitest": ["package-resolution-contract"], "security": ["package-resolution-contract"], "docs": ["package-lifecycle-docs-contract"]}
      },
      {
        "requirement_id": "build-extensible-plugin-platform/extension-package-and-feature-lifecycle/package-source-abstraction",
        "evidence": {"unit": ["package-source-contract"], "integration": ["package-source-contract"], "uitest": ["package-source-contract"], "security": ["package-source-contract"], "docs": ["package-lifecycle-docs-contract"]}
      }
    ]
  }
}
