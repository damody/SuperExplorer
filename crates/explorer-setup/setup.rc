#define APP_VERSION 1,0,0,0
#define APP_VERSION_TEXT "1.0.0\0"
#define RT_MANIFEST 24

1 ICON "..\\explorer-app\\assets\\super-explorer.ico"
1 RT_MANIFEST "setup.manifest"

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Damody\0"
            VALUE "FileDescription", "SuperExplorer Setup\0"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "InternalName", "SuperExplorerSetup\0"
            VALUE "OriginalFilename", "SuperExplorer-Setup-x64.exe\0"
            VALUE "ProductName", "SuperExplorer\0"
            VALUE "ProductVersion", APP_VERSION_TEXT
            VALUE "LegalCopyright", "Damody\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
