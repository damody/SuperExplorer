{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superexplorer.invalid/openspec/build-extensible-plugin-platform/evidence-index.schema.json",
  "title": "Build extensible plugin platform evidence-index JSONL record",
  "description": "Each line of evidence-index.jsonl is one append-only event. event_id is globally unique. previous_event_sha256 links prior history for the same task; previous_index_sha256 links the immediately previous JSONL event globally. Both hashes use canonical JSON (sorted keys, compact UTF-8 serialization). Cross-record cardinality, authoritative-policy, checkpoint, and artifact-content verification are enforced by scripts/evidence_index_validator.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "previous_event_sha256",
    "previous_index_sha256",
    "task_id",
    "record_kind",
    "priority",
    "release_blocking",
    "mandatory",
    "status",
    "gate_id",
    "procedure_kind",
    "subcheck_key",
    "artifact_or_command",
    "cwd",
    "environment",
    "expected_exit_and_artifacts",
    "expected",
    "actual",
    "exit_code_or_reviewer",
    "sha256",
    "local_result_path",
    "immutable_locator",
    "artifact_manifest_sha256",
    "artifact_manifest_locator",
    "retention_policy",
    "related_gates",
    "adjustment_id",
    "timestamp",
    "evidence_scope",
    "depends_on"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "previous_event_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "previous_index_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "task_id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "record_kind": { "enum": ["leaf-result", "retained-bundle"] },
    "priority": { "enum": ["P0", "P1"] },
    "release_blocking": { "type": "boolean" },
    "mandatory": { "type": "boolean" },
    "status": {
      "enum": ["passed", "not-applicable", "superseded", "failed", "blocked", "stale", "unexecuted"]
    },
    "gate_id": { "type": "string", "minLength": 1 },
    "procedure_kind": { "enum": ["command", "manual"] },
    "subcheck_key": { "type": "string", "minLength": 1 },
    "artifact_or_command": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "environment": { "type": "object", "additionalProperties": { "type": "string" } },
    "expected_exit_and_artifacts": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": "string", "minLength": 1 },
    "exit_code_or_reviewer": { "oneOf": [{ "type": "integer" }, { "type": "string", "minLength": 1 }] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "local_result_path": { "type": ["string", "null"] },
    "immutable_locator": { "type": ["string", "null"] },
    "artifact_manifest_sha256": { "type": ["string", "null"] },
    "artifact_manifest_locator": { "type": ["string", "null"] },
    "retention_policy": { "enum": ["local-rerunnable-result", "signed-release-evidence-bundle"] },
    "related_gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "adjustment_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "evidence_scope": { "enum": ["production", "audit-backfill", "trait-mock-only"] },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } },
    "replacement_task_id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "not_applicable_condition": { "type": "string", "minLength": 1 },
    "stale_for_supersession_event_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revalidation_of_event_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revalidated_against_task_id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "allOf": [
    {
      "if": { "properties": { "procedure_kind": { "const": "command" } } },
      "then": { "properties": { "exit_code_or_reviewer": { "type": "integer" } } }
    },
    {
      "if": { "properties": { "procedure_kind": { "const": "manual" } } },
      "then": { "properties": { "exit_code_or_reviewer": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "record_kind": { "const": "leaf-result" } }, "required": ["record_kind"] },
      "then": {
        "properties": {
          "immutable_locator": { "type": "null" },
          "local_result_path": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+/result\\.json$" },
          "artifact_manifest_sha256": { "type": "null" },
          "artifact_manifest_locator": { "type": "null" },
          "retention_policy": { "const": "local-rerunnable-result" }
        }
      }
    },
    {
      "if": { "properties": { "record_kind": { "const": "retained-bundle" } }, "required": ["record_kind"] },
      "then": {
        "properties": {
          "immutable_locator": { "type": "string", "pattern": "^release://local/[A-Za-z0-9][A-Za-z0-9._/-]*#sha256=[0-9a-f]{64}$" },
          "local_result_path": { "type": "null" },
          "artifact_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifact_manifest_locator": { "type": "string", "pattern": "^release://local/[A-Za-z0-9][A-Za-z0-9._/-]*#sha256=[0-9a-f]{64}$" },
          "retention_policy": { "const": "signed-release-evidence-bundle" }
        }
      }
    }
  ]
}
